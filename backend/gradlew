#!/usr/bin/env sh
set -eu

GRADLE_VERSION="${GRADLE_VERSION:-8.10.2}"
GRADLE_HOME="${GRADLE_HOME:-$HOME/.gradle/gradle-$GRADLE_VERSION}"
GRADLE_DIST="$GRADLE_HOME/bin/gradle"

if [ ! -x "$GRADLE_DIST" ]; then
  rm -rf "$GRADLE_HOME"
  mkdir -p "$HOME/.gradle"
  TMP_ARCHIVE="${TMPDIR:-/tmp}/gradle-${GRADLE_VERSION}-bin.zip"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "$TMP_ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$TMP_ARCHIVE" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  else
    echo "Neither curl nor wget is available to download Gradle." >&2
    exit 1
  fi

  unzip -q "$TMP_ARCHIVE" -d "$HOME/.gradle"
  rm -f "$TMP_ARCHIVE"
fi

exec "$GRADLE_DIST" "$@"
